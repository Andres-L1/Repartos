{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chedexpulse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  // Los estáticos (dist/web) se sirven directamente; el Worker solo recibe /api/* y /auth/*.
  // Cualquier otra ruta sin fichero cae en index.html (SPA).
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  // Misma base D1 que el dashboard actual. migrations/ solo contiene CREATE TABLE IF NOT EXISTS sobre tablas cp_*.
  "d1_databases": [
    {
      "binding": "PULSE_DB",
      "database_name": "chedexpulse-users",
      "database_id": "d6a9e3c7-fe36-429f-9850-6c704e511799",
      "migrations_dir": "migrations",
      "migrations_table": "cp_d1_migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://chedexpulse.app",
    "BILLING_MODE": "beta_open"
  },
  "observability": { "enabled": false },
  "routes": [{ "pattern": "chedexpulse.app", "custom_domain": true }]
}
