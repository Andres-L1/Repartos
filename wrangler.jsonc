{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chedexpulse",
  "workers_dev": false,
  "preview_urls": false,
  "main": "pulse/worker.mjs",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./pulse/public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
  },
  "d1_databases": [
    {
      "binding": "PULSE_DB",
      "database_name": "chedexpulse-users",
      "database_id": "d6a9e3c7-fe36-429f-9850-6c704e511799",
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://chedexpulse.app",
  },
  "observability": {
    "enabled": false,
  },
  "routes": [
    {
      "pattern": "chedexpulse.app",
      "custom_domain": true,
    },
  ],
}
