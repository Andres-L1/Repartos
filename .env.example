# Copia a .env (ignorado por git) y rellena DEEPSEEK_API_KEY. Nunca subas claves reales.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Topes de consumo (opcionales; vacíos = valores por defecto de worker/ai.ts). Tarifas en euros por millón de tokens: rellénalas con la tarifa vigente de DeepSeek.
AI_ENABLED=
DEEPSEEK_MONTHLY_BUDGET_EUR=
DEEPSEEK_PRICE_IN_EUR_PER_M=
DEEPSEEK_PRICE_OUT_EUR_PER_M=
DEEPSEEK_MONTHLY_TOKEN_CAP=
DEEPSEEK_DAILY_TOKEN_CAP=
