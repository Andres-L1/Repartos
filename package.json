{
  "name": "chedex-pulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/wrangler.mjs dev --local",
    "preview": "node pulse/preview.mjs",
    "build": "node scripts/wrangler.mjs deploy --dry-run --outdir .cloudflare-build",
    "publish:cloudflare": "node scripts/wrangler.mjs deploy",
    "check": "node scripts/check.mjs",
    "test": "node --test pulse/tests/*.test.mjs",
    "assets:prepare": "node scripts/vendor-assets.mjs",
    "data:collect": "node scripts/collect-analytics.mjs",
    "format": "prettier --write \"pulse/**/*.{mjs,js,css,html}\" \"scripts/{check,collect-analytics,configure-auth,vendor-assets,wrangler}.mjs\" \"*.jsonc\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"pulse/**/*.{mjs,js,css,html}\" \"scripts/{check,collect-analytics,configure-auth,vendor-assets,wrangler}.mjs\" \"*.jsonc\" \".github/workflows/*.yml\""
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "maplibre-gl": "6.16.0"
  }
}
