{
  "name": "chedex-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chedex Pulse: plataforma de entrenamiento de ajedrez (Cloudflare Worker + D1 + React). Incluye el prototipo pedagógico de Fase 1 (PGN -> Stockfish -> diagnóstico -> explicación -> ejercicios).",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "chedex": "tsx src/cli.ts",
    "dev:web": "node scripts/copy-engine.mjs && vite --config web/vite.config.ts",
    "build:web": "node scripts/copy-engine.mjs && vite build --config web/vite.config.ts",
    "build": "npm run build:web && tsc --noEmit",
    "dev": "npm run build:web && npm run db:migrate:local && wrangler dev --local --local-upstream localhost:8787",
    "db:migrate:local": "wrangler d1 migrations apply PULSE_DB --local"
  },
  "dependencies": {
    "chessground": "^9.2.1",
    "chessops": "^0.14.0",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later"
}
