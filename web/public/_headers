/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://lichess.org; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self' https://lichess.org; frame-ancestors 'none'
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
